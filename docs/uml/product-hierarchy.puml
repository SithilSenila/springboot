@startuml
abstract class Product {
    - id : Long
    - name : String
    - price : double
    + Product()
    + Product(id : Long, name : String, price : double)
    + getId() : Long
    + setId(id : Long) : void
    + getName() : String
    + setName(name : String) : void
    + getPrice() : double
    + setPrice(price : double) : void
    + {abstract} getSummary() : String
}

interface Discountable {
    + applyDiscount(rate : double) : void
    + getDiscountedPrice() : double
}

class DigitalProduct {
    - discountedPrice : double
    - downloadUrl : String
    - fileSizeMB : double
    + DigitalProduct(id : Long, name : String, price : double, downloadUrl : String, fileSizeMB : double)
    + getDownloadUrl() : String
    + getFileSize() : double
    + getSummary() : String
    + applyDiscount(rate : double) : void
    + getDiscountedPrice() : double
}

class PhysicalProduct {
    - discountedPrice : double
    - weightKg : double
    - dimensions : String
    + PhysicalProduct()
    + PhysicalProduct(id : Long, name : String, price : double, weight : double, dimensions : String)
    + getWeightKg() : double
    + getDimensions() : String
    + getSummary() : String
    + applyDiscount(rate : double) : void
    + getDiscountedPrice() : double
}

' <|-- generalisation (extends): SOLID line, hollow triangle at Product
Product <|-- DigitalProduct
Product <|-- PhysicalProduct

' <|.. realisation (implements): DASHED line, hollow triangle at Discountable
Discountable <|.. DigitalProduct
Discountable <|.. PhysicalProduct
@enduml
