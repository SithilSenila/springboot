@startuml
class Product {
    - id : Long
    - name : String
    - price : double
    + Product()
    + Product(id : Long, name : String, price : double)
    + getId() : Long
    + setId(id : Long) : void
    + getName() : String
    + setName(name : String) : void
    + getPrice() : double
    + setPrice(price : double) : void
}

class DigitalProduct {
    - downloadUrl : String
    - fileSizeMB : double
    + DigitalProduct(id : Long, name : String, price : double, downloadUrl : String, fileSizeMB : double)
    + getDownloadUrl() : String
    + getFileSize() : double
}

class PhysicalProduct {
    - weightKg : double
    - dimensions : String
    + PhysicalProduct()
    + PhysicalProduct(id : Long, name : String, price : double, weight : double, dimensions : String)
    + getWeightKg() : double
    + getDimensions() : String
}

' <|-- is the inheritance (generalisation) arrow. The hollow triangle sits at the PARENT (Product) end.
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
@enduml
